#!/bin/bash

BRANCH=$(git rev-parse --abbrev-ref HEAD)
BASE_BRANCH="dev"

# main, dev, feat/ci 브랜치는 skip
if [[ "$BRANCH" == "main" || "$BRANCH" == "dev" || "$BRANCH" == "feat/ci" ]]; then
  exit 0
fi

# 필수 도구 확인
if ! command -v gh &>/dev/null; then
  echo "️  gh CLI가 설치되어 있지 않습니다. PR 자동 생성을 건너뜁니다."
  echo "  설치: brew install gh && gh auth login"
  exit 0
fi

if ! command -v claude &>/dev/null; then
  echo "  claude CLI가 설치되어 있지 않습니다. PR 자동 생성을 건너뜁니다."
  exit 0
fi

if [[ -z "$GITHUB_TOKEN" ]]; then
  echo "  GITHUB_TOKEN 환경변수가 설정되어 있지 않습니다. PR 자동 생성을 건너뜁니다."
  echo "  설정: export GITHUB_TOKEN=ghp_xxxx"
  exit 0
fi

# 이미 PR이 존재하면 skip
EXISTING_PR=$(gh pr list --head "$BRANCH" --base "$BASE_BRANCH" --json number --jq '.[0].number' 2>/dev/null)
if [[ -n "$EXISTING_PR" ]]; then
  echo "️  이미 PR이 존재합니다 (#${EXISTING_PR}). 건너뜁니다."
  exit 0
fi

echo ""
echo " PR 자동 생성 중... (백그라운드 실행)"
echo ""

# 백그라운드로 실행해서 터미널 블로킹 방지
nohup claude -p "
다음 조건에 맞게 GitHub PR을 생성해줘.

- 레포지토리: KUSITMS-CHECKMATE/MATE-SERVER
- head 브랜치: ${BRANCH}
- base 브랜치: ${BASE_BRANCH}
- 커밋 로그와 변경 파일을 분석해서 PR 제목과 본문을 작성해줘.
- PR 본문은 아래 템플릿을 반드시 사용해줘:

## 📍 요약
- 무엇을/왜 변경했는지 한 줄로

## 🔗 관련 이슈
- Closes #이슈번호

## 📌 변경 사항
- [ ] 기능
- [ ] 버그 수정
- [ ] 리팩토링
- [ ] 문서
- [ ] 테스트
- [ ] 기타

## ✅ 작업 내용
- 작업 1
- 작업 2

## 테스트
- [ ] 로컬 테스트 완료
- 테스트 방법:

PR 제목은 브랜치명과 커밋 내용을 보고 한국어로 간결하게 작성해줘.
" >> /tmp/claude-pr-$(echo "$BRANCH" | tr '/' '-').log 2>&1 &

echo " PR 생성 작업이 백그라운드에서 실행 중입니다."
echo "   로그 확인: tail -f /tmp/claude-pr-$(echo "$BRANCH" | tr '/' '-').log"
